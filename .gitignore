# Monorepo-wide rules. Each app has its own .gitignore for its build artefacts (see front/.gitignore).

# Dependencies (any app)
node_modules/
.pnpm-store/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini
